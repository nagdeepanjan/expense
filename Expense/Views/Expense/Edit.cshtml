@model MyExpense

@{
    ViewData["Title"] = "Edit Expense";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">Edit Expense</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" placeholder="Enter expense description" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" placeholder="0.00" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label">Category</label>
                            <div class="row">
                                <div class="col-md-8">
                                    <input asp-for="Category" class="form-control" list="categoryList" 
                                           placeholder="Enter or select category" />
                                    <datalist id="categoryList">
                                        @foreach (var category in ViewBag.Categories as IEnumerable<string> ?? new List<string>())
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </datalist>
                                </div>
                                <div class="col-md-4">
                                    <select class="form-select" id="predefinedCategories">
                                        <option value="">Quick Select...</option>
                                        <option value="Food & Dining">Food & Dining</option>
                                        <option value="Transportation">Transportation</option>
                                        <option value="Shopping">Shopping</option>
                                        <option value="Entertainment">Entertainment</option>
                                        <option value="Bills & Utilities">Bills & Utilities</option>
                                        <option value="Healthcare">Healthcare</option>
                                        <option value="Travel">Travel</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date" class="form-label">Date</label>
                            <input asp-for="Date" class="form-control" type="date" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                            <div>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger me-2">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Update Expense
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Auto-fill category from predefined dropdown
        document.getElementById('predefinedCategories').addEventListener('change', function() {
            if (this.value) {
                document.getElementById('Category').value = this.value;
                this.value = ''; // Reset dropdown
            }
        });

        // Focus on description field when page loads
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('Description').focus();
        });
    </script>
}