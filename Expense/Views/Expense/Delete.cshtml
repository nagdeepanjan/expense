@model MyExpense

@{
    ViewData["Title"] = "Delete Expense";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Delete Expense
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning!</strong> Are you sure you want to delete this expense? This action cannot be undone.
                    </div>

                    <h4>Expense Details:</h4>
                    <dl class="row">
                        <dt class="col-sm-3">Description:</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3">Amount:</dt>
                        <dd class="col-sm-9 text-success fw-bold">@Model.FormattedAmount</dd>

                        <dt class="col-sm-3">Category:</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-secondary">@Model.Category</span>
                        </dd>

                        <dt class="col-sm-3">Date:</dt>
                        <dd class="col-sm-9">@Model.FormattedDate</dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                            
                            <div>
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">
                                    <i class="fas fa-edit"></i> Edit Instead
                                </a>
                                <button type="submit" class="btn btn-danger" 
                                        onclick="return confirm('Are you absolutely sure you want to delete this expense?')">
                                    <i class="fas fa-trash"></i> Yes, Delete
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">